# LinkedIn Job Scraper Bot - Configuration
# Copy this file to .env and fill in your values

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Scraper Configuration — keyword disesuaikan dengan profil Muhamad Cep Zamil
SEARCH_KEYWORDS=administration staff,data entry,operational support,management trainee,general affairs,document control,HR admin,customer service,project coordinator,QA tester
SEARCH_LOCATION=Indonesia
SCRAPE_INTERVAL_MINUTES=60

# Output Configuration
OUTPUT_DIR=output
OUTPUT_FORMAT=csv
